{
  "compilerOptions": {
    "target": "es2023",
    "module": "Node16",
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": true,
    "sourceMap": false,
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": ["*"]
  },
  "include": ["src/**/*.ts"]
}
